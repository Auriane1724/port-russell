<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <style>
      body {
        font-family: system-ui, -apple-system, Arial;
        margin: 0;
      }
      header {
        padding: 16px 24px;
        background: #0b1b2b;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
      }
      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 10px;
      }
      a.navlink {
        color: white;
        text-decoration: none;
        padding: 8px 10px;
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 10px;
      }
      a.navlink:hover {
        background: rgba(255, 255, 255, 0.1);
      }
      main {
        padding: 24px;
        max-width: 1100px;
        margin: 0 auto;
      }
      .card {
        border: 1px solid #ddd;
        border-radius: 12px;
        padding: 16px;
        margin-top: 16px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
      }
      th,
      td {
        border-bottom: 1px solid #eee;
        padding: 8px;
        text-align: left;
        vertical-align: top;
      }
      th {
        background: #fafafa;
      }
      .muted {
        color: #666;
        font-size: 13px;
      }
      .btn {
        padding: 8px 10px;
        border-radius: 10px;
        border: 0;
        cursor: pointer;
      }
      .btn-secondary {
        background: #eaeaea;
      }
    </style>
  </head>
  <body>
    <header>
      <div>
        <strong>Port Russell — Tableau de bord</strong>
        <div class="muted" style="color: #cfd7e1; margin-top: 6px">
          Connecté : <%= user.name %> — <%= user.email %> • Date : <%= new
          Date(today).toLocaleDateString("fr-FR") %>
        </div>

        <nav>
          <a class="navlink" href="/dashboard">Dashboard</a>
          <a class="navlink" href="/catways">Catways (CRUD)</a>
          <a class="navlink" href="/reservations">Réservations (CRUD)</a>
          <a class="navlink" href="/users">Utilisateurs (CRUD)</a>
          <a class="navlink" href="/api-docs">Doc API</a>
        </nav>
      </div>

      <form method="POST" action="/logout">
        <button class="btn btn-secondary" type="submit">Se déconnecter</button>
      </form>
    </header>

    <main>
      <section class="card">
        <h2>Réservations en cours</h2>

        <% if (!currentReservations || currentReservations.length === 0) { %>
        <p class="muted">Aucune réservation en cours aujourd’hui.</p>
        <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Catway</th>
              <th>Client</th>
              <th>Bateau</th>
              <th>Début</th>
              <th>Fin</th>
            </tr>
          </thead>
          <tbody>
            <% currentReservations.forEach(r => { %>
            <tr>
              <td><%= r.catwayNumber %></td>
              <td><%= r.clientName %></td>
              <td><%= r.boatName %></td>
              <td><%= new Date(r.startDate).toLocaleDateString("fr-FR") %></td>
              <td><%= new Date(r.endDate).toLocaleDateString("fr-FR") %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } %>
      </section>
    </main>
  </body>
</html>
